	local function findAllSheriffs()
		local sheriffs = {}
		for _, p in pairs(Players:GetPlayers()) do
			if isSheriff(p) and p ~= player then -- On s'exclut soi-même
				table.insert(sheriffs, p)
			end
		end
		return sheriffs
	end
	
