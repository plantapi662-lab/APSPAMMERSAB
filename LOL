			return 
		end
	
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then 
			script.Parent:SetAttribute("IsRunning", false)
			return 
		end
	
		local pos = root.Position
	
		-- Configuration
		local SPREAD_RADIUS = 2.5
		local Y_OFFSET = 2.5
	
		-- Tableau pour garder une trace des joueurs gelés
		local frozenPlayers = {}
	
		-- Fonction pour freezer un joueur
		local function freezePlayer(character)
			if not character then return end
	
			local humanoid = character:FindFirstChild("Humanoid")
			if humanoid and humanoid.Health > 0 then
				humanoid.WalkSpeed = 0
				humanoid.JumpPower = 0
				humanoid.AutoRotate = false
				humanoid.PlatformStand = true
			end
	
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = true
					part.CanCollide = false
				end
			end
		end
	
		-- Fonction pour défreezer un joueur avec vérifications de sécurité
		local function unfreezePlayer(character)
			if not character then return end
	
			-- Vérifier si le personnage existe toujours et est valide
			if not character.Parent then return end
	
			local humanoid = character:FindFirstChild("Humanoid")
			if humanoid then
				-- Restaurer les propriétés par défaut
				humanoid.WalkSpeed = 16
				humanoid.JumpPower = 50
				humanoid.AutoRotate = true
				humanoid.PlatformStand = false
			end
	
			-- Désancher toutes les pièces
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					-- Vérifier si la pièce existe toujours
					if part and part.Parent then
						pcall(function()
							part.Anchored = false
							part.CanCollide = true
						end)
					end
				end
			end
		end
	
		-- Fonction pour défreezer tout le monde en toute sécurité
		local function unfreezeAll()
			-- Créer une copie de la liste pour éviter les problèmes de modification
			local playersToUnfreeze = {}
			for _, v in ipairs(frozenPlayers) do
				table.insert(playersToUnfreeze, v)
			end
	
			-- Vider la liste des joueurs gelés
			frozenPlayers = {}
	
			-- Dégeler chaque joueur
			for _, v in ipairs(playersToUnfreeze) do
				local success, err = pcall(function()
					if v and v.Parent then
						unfreezePlayer(v)
					end
				end)
				if not success then
					warn("Erreur lors du dégel d'un joueur:", err)
				end
			end
		end
	
		-- Compteur de joueurs
		local count = 0
		frozenPlayers = {} -- Réinitialiser la liste
	
