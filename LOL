					if vRoot and vRoot.Parent then
						local angle = math.rad(count * 72)
						local offsetX = math.cos(angle) * SPREAD_RADIUS
						local offsetZ = math.sin(angle) * SPREAD_RADIUS
	
						local targetPos = pos + Vector3.new(offsetX, Y_OFFSET, offsetZ)
	
						-- Déplacer le joueur en toute sécurité
						pcall(function()
							vRoot.CFrame = CFrame.new(targetPos)
							vRoot.Velocity = Vector3.new(0, 0, 0)
							vRoot.RotVelocity = Vector3.new(0, 0, 0)
						end)
	
						freezePlayer(vChar)
						table.insert(frozenPlayers, vChar)
						count = count + 1
					end
				end
			end
		end
	
		print("👥 " .. count .. " joueurs regroupés et gelés")
	
		-- Dégeler automatiquement après 5 secondes
		task.wait(5)
	
		-- Dégeler en toute sécurité
		local success, err = pcall(unfreezeAll)
