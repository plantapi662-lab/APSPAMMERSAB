			return
		end
	
		local playerRoot = playerChar:FindFirstChild("HumanoidRootPart")
		if not playerRoot then
			print("❌ HumanoidRootPart introuvable !")
			return
		end
	
		local humanoid = targetChar:FindFirstChild("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			print("❌ Le sheriff est mort, passage au suivant !")
			currentIndex = currentIndex + 1
			if currentIndex > #sheriffList then
				currentIndex = 1
			end
			teleportToSheriff() -- Rappel pour aller au prochain
			return
		end
	
		-- Calculer la direction où le sheriff regarde
		local lookVector = targetRoot.CFrame.LookVector
		local distance = 5
	
		-- Téléporter en face du sheriff
		local newCFrame = CFrame.new(targetRoot.Position + lookVector * distance, targetRoot.Position)
		playerRoot.CFrame = newCFrame
	
		print("✅ Téléporté en face de " .. target.Name)
	
		-- Passer au sheriff suivant pour le prochain clic
		currentIndex = currentIndex + 1
		if currentIndex > #sheriffList then
			currentIndex = 1
		end
	end
	
	-- Mise à jour initiale
	updateSheriffList()
	
	-- Quand on clique sur le bouton, on se téléporte
	script.Parent.MouseButton1Click:Connect(teleportToSheriff)
	
