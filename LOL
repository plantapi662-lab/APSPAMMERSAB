	local function updateSheriffList()
		sheriffList = findAllSheriffs()
		if #sheriffList > 0 then
			if currentIndex > #sheriffList then
				currentIndex = 1
			end
			print("🔫 " .. #sheriffList .. " sheriff(s) trouvé(s)")
		else
			print("❌ Aucun sheriff détecté !")
		end
	end
	
