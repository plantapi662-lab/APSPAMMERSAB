local function C_1a()
local script = G2L["1a"];
	-- Met ceci dans un LocalScript séparé
	
	local Players = game:GetService("Players")
	local PlayerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
	
	local lastMurder = nil
	
	-- RÉCUPÉRATION DU TEXTBOX (c'est un TextBox mais avec les options désactivées)
	local murderTextBox = PlayerGui:WaitForChild("FrameGamePlay"):WaitForChild("ScrollingFrame"):FindFirstChild("MurderIS")
	
	local function updateMurderLabel(murdererName)
		if murderTextBox then
			if murdererName then
				murderTextBox.Text = "MURDER IS: " .. string.upper(murdererName)
			else
				murderTextBox.Text = "MURDER IS: UNKNOWN"
			end
		end
	end
	
	local function isMurder(player)
		local backpack = player:FindFirstChild("Backpack")
		local character = player.Character
	
		if backpack and backpack:FindFirstChild("Knife") then
			return true
		end
	
		if character and character:FindFirstChild("Knife") then
			return true
		end
	
		return false
	end
	
	local function scanMurder()
		local foundMurder = false
	
		for _, player in pairs(Players:GetPlayers()) do
			if isMurder(player) then
				foundMurder = true
	
				if lastMurder ~= player.Name then
					print("NebulaHub | Murder Detected : " .. player.Name)
					updateMurderLabel(player.Name)
					lastMurder = player.Name
				end
				break
			end
		end
	
		if not foundMurder and lastMurder ~= nil then
			print("NebulaHub | Murder Detected : None")
			updateMurderLabel(nil)
			lastMurder = nil
		end
	end
	
	-- Scan toutes les secondes
	task.spawn(function()
		while true do
			scanMurder()
			task.wait(1)
		end
	end)
	
	-- Scan quand un joueur rejoint
	Players.PlayerAdded:Connect(function()
		scanMurder()
	end)
	
	-- Scan quand un joueur quitte
	Players.PlayerRemoving:Connect(function()
		scanMurder()
	end)
	
	-- Premier scan au démarrage
	scanMurder()
end;
