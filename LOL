	local function teleportToSheriff()
		-- Mettre à jour la liste
		updateSheriffList()
	
		if #sheriffList == 0 then
			print("❌ Aucun sheriff détecté !")
			return
		end
	
		local target = sheriffList[currentIndex]
	
		if not target then
			print("❌ Sheriff introuvable !")
