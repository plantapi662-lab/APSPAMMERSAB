			print("🔓 Tous les joueurs ont été dégelés automatiquement après 5 secondes")
		else
			warn("Erreur lors du dégel:", err)
			-- Tentative de dégel de secours
			for _, v in ipairs(game.Players:GetPlayers()) do
				if v ~= player then
					pcall(function()
						if v.Character then
							unfreezePlayer(v.Character)
						end
					end)
				end
			end
		end
	
		-- Réactiver le bouton
		script.Parent:SetAttribute("IsRunning", false)
	end)
